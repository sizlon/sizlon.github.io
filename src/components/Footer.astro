---
import { ext } from '../i18n/utils';
import { site, servicePages, legalLinks } from '../config/site';
import type { Lang } from '../i18n/content';
import { t, localizePath } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
---

<footer class="footer band-ink">
  {lang === 'en' ? (
  <div class="wrap footer-inner en">
    <div class="col brandcol">
      <a class="brand" href="/en/">
        <img src="/logo/sizlon-logo-white.svg" alt="Sizlon" width="95" height="24" />
      </a>
      <p class="tag">{tr.footer.tagline}</p>
    </div>
    <nav class="col" aria-label={tr.footer.company}>
      <span class="eyebrow">{tr.footer.company}</span>
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      <a href={`tel:${site.contactPhoneIntl}`}>{site.contactPhoneIntl}</a>
      <a href="/">{tr.common.koreanSite} &rarr;</a>
    </nav>
    <nav class="col" aria-label={tr.common.legalNote}>
      <span class="eyebrow">{tr.common.legalNote}</span>
      {legalLinks.map((item) => <a href={item.href} hreflang="ko">{tr.legalNav[item.key]}</a>)}
    </nav>
  </div>
  ) : (
  <div class="wrap footer-inner">
    <div class="col brandcol">
      <a class="brand" href={localizePath('/', lang)}>
        <img src="/logo/sizlon-logo-white.svg" alt="시즐론 Sizlon" width="95" height="24" />
      </a>
      <p class="tag">{tr.footer.tagline}</p>
    </div>

    <nav class="col" aria-label={tr.footer.services}>
      <span class="eyebrow">{tr.footer.services}</span>
      {servicePages.map((item) => <a href={item.href} {...ext(item.href)}>{tr.nav[item.key]}</a>)}
    </nav>

    <nav class="col" aria-label={tr.footer.work}>
      <span class="eyebrow">{tr.footer.work}</span>
      {tr.footer.workItems.map((item) => <a href={item.href} {...ext(item.href)}>{item.label}</a>)}
    </nav>

    <nav class="col" aria-label={tr.footer.company}>
      <span class="eyebrow">{tr.footer.company}</span>
      <a href="/about/">{tr.nav.about}</a>
      <a href="/founder/">{tr.nav.founder}</a>
      <a href="/contact/">{tr.nav.contact}</a>
      <a href={`tel:${site.contactPhoneIntl}`}>{site.contactPhone}</a>
      <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
    </nav>

    <nav class="col" aria-label={tr.footer.legal}>
      <span class="eyebrow">{tr.footer.legal}</span>
      {legalLinks.map((item) => <a href={item.href}>{tr.legalNav[item.key]}</a>)}
      <a href="/services/data/#principles">{tr.footer.principles}</a>
    </nav>
  </div>
  )}

  <div class="wrap bizinfo">
    <span>{tr.footer.business}</span>
  </div>

  <div class="wrap baseline">
    <span>&copy; {new Date().getFullYear()} Sizlon</span>
    <span class="note">{tr.footer.baseline}</span>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--hairline-dark); padding-top: var(--section-y); }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
    gap: 2rem;
    padding-bottom: 3rem;
  }
  .col { display: flex; flex-direction: column; gap: 0.6rem; align-items: flex-start; }
  .col a {
    text-decoration: none;
    color: var(--slate-on-dark);
    font-size: var(--step--1);
  }
  .col a:hover { color: var(--color-mist); }
  .brand { display: inline-flex; align-items: center; }
  .brand img { display: block; height: 24px; width: auto; }
  .tag { color: var(--slate-on-dark); font-size: var(--step--1); }
  .bizinfo {
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline-dark);
    font-size: var(--step--1);
    color: var(--slate-on-dark);
    line-height: 1.7;
  }
  .baseline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1rem 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--slate-on-dark);
  }
  .footer-inner.en { grid-template-columns: 1.6fr 1fr 1fr; }
  @media (max-width: 1080px) {
    .footer-inner { grid-template-columns: 1.6fr 1fr 1fr; }
  }
  @media (max-width: 720px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }
</style>
