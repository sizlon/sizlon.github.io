---
import { t, localizePath, logicalPath, ext } from '../i18n/utils';
import { site, nav } from '../config/site';
import type { Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const logical = logicalPath(Astro.url);
const homeHref = localizePath('/', lang);
// 언어 스위치는 홈 한 쌍만 — 다른 페이지에서 EN 을 누르면 /en/ 으로 간다.
const otherLangHref = lang === 'ko' ? '/en/' : '/';
const telHref = `tel:${site.contactPhoneIntl}`;
// 표기는 로케일을 따른다 — 한국어 02-…, 영어 +82-….
const phoneLabel = lang === 'en' ? site.contactPhoneIntl : site.contactPhone;
// /en/ 은 한 장뿐이다 — 내비가 한국어 페이지로 이끌면 영어로 들어온 사람이 한 번 클릭에
// 한국어 사이트로 떨어진다(2026-09-06 보고). 영어 크롬은 이메일·전화·KO 만 낸다.
const navItems = lang === 'en' ? [] : nav;
// 헤더 라벨은 짧은 말(navShort) 우선 — 6항목이 821px 에서 접히지 않게(2026-09-11).
const label = (key: string) => tr.navShort[key] ?? tr.nav[key as keyof typeof tr.nav];
// 문의는 링크 대신 오른쪽 전화 자리의 버튼으로 합쳤다(2026-09-11): 한국어는 /contact/ 로, 영어는 종전대로 tel:.
const utilityHref = lang === 'en' ? telHref : '/contact/';
const langLabel = lang === 'en' ? tr.common.koreanSite : tr.common.langSwitch;
---

<header class="nav band-ink">
  <div class="wrap nav-inner">
    <a class="brand" href={homeHref}>
      <img src="/logo/sizlon-logo-white.svg" alt="시즐론 Sizlon" width="107" height="27" />
    </a>

    <nav class="links" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={localizePath(item.href, lang)}
          {...ext(item.href)}
          class="link"
          aria-current={logical === item.href ? 'page' : undefined}
        >
          {label(item.key)}
        </a>
      ))}
    </nav>

    <div class="utility">
      {lang === 'en' && <a class="phone" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}
      {/* 960px 아래에선 번호를 숨겨 '문의' 만 — 링크 6 + 버튼이 821px 에서 한 줄에 들어가야 한다(09-11 실측: 필요 821 vs 가용 729). */}
      <a class="phone" href={utilityHref} aria-current={lang !== 'en' && logical === '/contact/' ? 'page' : undefined}>{lang === 'en' ? phoneLabel : <>{tr.nav.contact}<span class="num"> · {phoneLabel}</span></>}</a>
      {/* 접근 가능 이름은 보이는 글자를 포함해야 한다(axe label-content-name-mismatch, 2026-09-07). */}
      <a class="lang" href={otherLangHref} aria-label={lang === 'en' ? `${langLabel} (한국어)` : `${langLabel} — English site`}>{langLabel}</a>
    </div>

    <details class="mnav" data-mobile-nav>
      <summary class="hamburger" aria-label={tr.common.menu} title={tr.common.menu}>
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </summary>

      <div class="panel">
        <nav class="m-links" aria-label="Primary">
          {navItems.map((item) => (
            <a
              href={localizePath(item.href, lang)}
              {...ext(item.href)}
              class="m-link"
              aria-current={logical === item.href ? 'page' : undefined}
            >
              {label(item.key)}
            </a>
          ))}
          {lang !== 'en' && <a href="/contact/" class="m-link" aria-current={logical === '/contact/' ? 'page' : undefined}>{tr.nav.contact}</a>}
        </nav>

        <div class="m-divider"></div>

        {lang === 'en' && <a class="m-phone" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}
        <a class="m-phone" href={telHref}>{tr.common.call} {phoneLabel} <span class="m-hours">{tr.common.hours}</span></a>
        <a class="m-lang" href={otherLangHref}>{lang === 'en' ? tr.common.koreanSite : tr.common.langSwitch}</a>
      </div>
    </details>
  </div>
</header>

<script>
  // Progressive enhancement: <details> already opens/closes without JS.
  // This adds Escape-to-close, outside-click-to-close, and auto-close when
  // the viewport grows past the mobile breakpoint.
  const details = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
  if (details) {
    const close = () => details.removeAttribute('open');
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.open) close();
    });
    document.addEventListener('click', (e) => {
      if (details.open && !details.contains(e.target as Node)) close();
    });
    window.matchMedia('(min-width: 821px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--hairline-dark);
    backdrop-filter: saturate(1.1);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
  }
  .brand img { display: block; height: 27px; width: auto; }
  .links {
    display: flex;
    gap: 1.1rem;
    margin-inline-start: auto;
    flex-wrap: wrap;
  }
  .link {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--slate-on-dark);
    padding: 0.25rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }
  .link:hover { color: var(--color-mist); }
  .link[aria-current='page'] {
    color: var(--color-mist);
    border-color: var(--color-recovered);
  }
  .utility {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  .phone {
    text-decoration: none;
    color: var(--color-recovered);
    white-space: nowrap;
  }
  .lang { color: var(--slate-on-dark); text-decoration: none; }
  .lang:hover { color: var(--color-mist); }

  /* Mobile disclosure nav — hidden on desktop. */
  .mnav { display: none; }
  .hamburger {
    list-style: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    cursor: pointer;
    border-radius: var(--radius);
  }
  .hamburger::-webkit-details-marker { display: none; }
  .hamburger:focus-visible { outline: 2px solid var(--color-recovered); outline-offset: 2px; }
  .hamburger .bar {
    height: 2px;
    width: 100%;
    background: var(--color-mist);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .mnav[open] .hamburger .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mnav[open] .hamburger .bar:nth-child(2) { opacity: 0; }
  .mnav[open] .hamburger .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-ink);
    border-bottom: 1px solid var(--hairline-dark);
    padding: 0.5rem var(--gutter) 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.5);
  }
  .m-links { display: flex; flex-direction: column; }
  .m-link {
    font-size: var(--step-1);
    text-decoration: none;
    color: var(--color-mist);
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--hairline-dark);
  }
  .m-link[aria-current='page'] { color: var(--color-recovered); }
  .m-divider { height: 0.5rem; }
  .m-phone {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--color-recovered);
    padding: 0.6rem 0;
  }
  .m-hours { color: var(--slate-on-dark); font-size: var(--step--1); margin-left: 0.5em; }
  .m-lang {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--slate-on-dark);
    text-decoration: none;
    padding-top: 0.4rem;
  }

  @media (max-width: 960px) { .phone .num { display: none; } }
  @media (max-width: 820px) {
    .links, .utility { display: none; }
    .mnav { display: block; margin-inline-start: auto; }
  }
</style>
