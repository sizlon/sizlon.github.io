---
import { ext } from '../i18n/utils';
// 공개 작업 (09-14, 구 '만든 것들' v3 §3.5) — sizlon 조직의 공개 저장소만. 기준·제외 목록은 content.ko.work 주석.
import Base from '../layouts/Base.astro';
import { content } from '../i18n/content';

const c = content.ko.work;
---

<Base title={c.title} description={c.description} lang="ko">
  <section class="hero band-ink section">
    <div class="wrap head">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </section>

  <section class="section wrap items">
    {c.items.map((it) => (
      <article class="item" id={it.id}>
        <span class="eyebrow status">{it.tag}</span>
        <h2>{it.name}</h2>
        <p class="body">{it.body}</p>
        <div class="links">
          {it.links.map((l) => <a class="btn btn-ghost" href={l.href} {...ext(l.href)}>{l.label} <span class="arrow">&rarr;</span></a>)}
        </div>
      </article>
    ))}
  </section>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: 1rem; max-width: var(--measure); }
  .items { display: flex; flex-direction: column; gap: 2.5rem; max-width: var(--measure); }
  .item { display: flex; flex-direction: column; gap: 0.8rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--hairline); }
  .item:last-child { border-bottom: 0; }
  .item h2 { font-size: var(--step-2); }
  .status { color: var(--color-recovered); }
  .body { color: color-mix(in srgb, var(--color-ink) 85%, var(--color-vellum)); line-height: 1.7; }
  .links { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.25rem; }
  .links .btn { max-width: 100%; overflow-wrap: anywhere; }
</style>
