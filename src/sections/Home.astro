---
import { ext } from '../i18n/utils';
// 홈 (v3 §3.1 → v5 2026-09-14) — 만든 시스템 셋 × 쓰임새. 히어로 철학 문구는 푸터로.
import Base from '../layouts/Base.astro';
import { servicePages } from '../config/site';
import { content } from '../i18n/content';

const tr = content.ko;
const c = tr.home;
const hrefOf = (key: string) => servicePages.find((s) => s.key === key)?.href ?? '/contact/';
---

<Base title={c.title} description={c.description} lang="ko" rawTitle>
  <section class="hero band-ink">
    <div class="wrap hero-copy">
      {/* 10-07 오너: 히어로는 h1 세 줄만 — lede·예약/전화 버튼·고정가 줄 삭제(문의는 헤더 버튼) */}
      <h1>{c.h1Lines.map((l) => <span class="h1-line">{l}</span>)}</h1>
    </div>
  </section>

  {/* 09-29: 첫 칸(검색 진단)을 넓게, 나머지 둘(데이터 파이프라인·요구사항 대조 엔진)은 나란히. 칸마다 수치(잣대 병기)와 쓰임새 카드. */}
  <section class="section wrap">
    <div class="head">
      <span class="eyebrow">{c.systemsEyebrow}</span>
      <h2>{c.systemsH2}</h2>
    </div>
    <div class="systems">
      {c.systems.map((sys) => (
        <article class:list={['system', { featured: 'featured' in sys && sys.featured }]} id={sys.key}>
          <div class="sys-head">
            <span class="eyebrow no">{sys.no}</span>
            <h3>{'href' in sys ? <a href={sys.href}>{sys.name}</a> : sys.name}</h3>
            <p class="sys-text">{sys.text}</p>
            {'stages' in sys && <ol class="stages">{sys.stages.map((st) => <li>{st}</li>)}</ol>}
          </div>
          <dl class="facts">
            {sys.facts.map((f) => (
              <div class="fact">
                <dt>{'href' in f ? <a href={f.href} {...ext(f.href)}>{f.v}</a> : f.v}</dt>
                <dd>{f.note}</dd>
              </div>
            ))}
          </dl>
          {'factsNote' in sys && <p class="facts-note">{sys.factsNote}</p>}
          <span class="eyebrow uses-label">{'usesLabel' in sys ? sys.usesLabel : c.usesLabel}</span>
          <div class="uses">
            {sys.uses.map((u) => (
              <a class="card" href={hrefOf(u.key)} {...ext(hrefOf(u.key))}>
                <span class="eyebrow situation">{u.situation}</span>
                <span class="use-name">{u.name}</span>
                <span class="terms">{u.terms}</span>
                <span class="deliverable">{u.deliverable}</span>
                <span class="more">자세히 <span class="arrow">&rarr;</span></span>
              </a>
            ))}
          </div>
          {'scan' in sys && <p class="scan"><a href={sys.scan.href}>{sys.scan.label} &rarr;</a></p>}
          {'hrefLabel' in sys && <p class="sys-link"><a href={sys.href}>{sys.hrefLabel} &rarr;</a></p>}
        </article>
      ))}
    </div>
    <p class="vat eyebrow">{tr.common.vatNote}</p>
  </section>

  <section class="section wrap work tight">
    <p>{c.workLine}</p>
    <a class="btn btn-ghost" href="/work/">{c.workLink} <span class="arrow">&rarr;</span></a>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3.5rem, 2rem + 8vw, 7rem); }
  .hero-copy { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; max-width: 60ch; }
  /* 문장마다 한 줄(09-14·10-07) — 옛 최장 줄('요구사항을 대조하는 엔진을 만들고,') 약 13.5em 기준이라 좁은 폰에서도 세 줄을 넘지 않게 폭에 맞춰 줄인다 */
  .hero h1 { max-width: none; font-size: min(var(--step-4), calc((100vw - 2 * var(--gutter)) / 14.4)); }
  .h1-line { display: block; }
  .head { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem; max-width: var(--measure); }
  .systems { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr)); gap: 1.25rem; }
  .system { display: flex; flex-direction: column; gap: 1rem; padding: 1.6rem; border: 1px solid var(--hairline); border-radius: var(--radius); background: var(--color-mist); min-width: 0; }
  /* 09-14: 세 칸 배경을 같게 — 엔진 칸 강조는 가로 전체 폭과 큰 제목으로만 */
  .system.featured { grid-column: 1 / -1; }
  .sys-head { display: flex; flex-direction: column; gap: 0.6rem; max-width: var(--measure); }
  .no { color: var(--color-recovered); }
  .system h3 { font-size: var(--step-1); }
  .system.featured h3 { font-size: var(--step-2); }
  .system h3 a { color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  .sys-text { color: color-mix(in srgb, var(--color-ink) 85%, var(--color-vellum)); line-height: 1.65; }
  .stages { list-style: none; margin: 0.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem; font-family: var(--font-mono); font-size: var(--step--1); }
  .stages li { position: relative; padding: 0.2rem 0.7rem; border: 1px solid var(--hairline); border-radius: 999px; }
  .stages li + li::before { content: '→'; position: absolute; left: -1.25rem; color: var(--color-slate); }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); border-radius: var(--radius); overflow: hidden; }
  .system:not(.featured) .facts { grid-template-columns: 1fr; }
  .fact { background: var(--color-vellum); padding: 0.85rem 1rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .fact dt { font-family: var(--font-mono); font-weight: 600; font-size: var(--step-0); }
  .fact dt a { color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  .fact dd { margin: 0; color: var(--color-slate); font-size: var(--step--1); line-height: 1.5; }
  .facts-note { color: var(--color-slate); font-size: var(--step--1); }
  .uses-label { margin-top: 0.25rem; }
  .uses { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 0.75rem; }
  .card {
    display: flex; flex-direction: column; gap: 0.45rem; padding: 1.1rem 1.25rem;
    border: 1px solid var(--hairline); border-radius: var(--radius); background: var(--color-vellum);
    text-decoration: none; color: inherit; transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover { border-color: var(--color-recovered); transform: translateY(-2px); }
  .situation { color: var(--color-recovered); }
  .use-name { font-weight: 600; font-size: var(--step-0); }
  .terms { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-ink); }
  .deliverable { color: var(--color-slate); font-size: var(--step--1); }
  .more { margin-top: 0.2rem; font-weight: 600; font-size: var(--step--1); }
  .more .arrow { transition: transform 0.15s ease; display: inline-block; }
  .card:hover .more .arrow { transform: translateX(3px); }
  .scan a, .sys-link a { color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); font-size: var(--step--1); }
  .vat { margin-top: 1.25rem; }
  .work { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  /* 근거·작업 방식·만든 것들은 짧은 절이라 기본 section 여백이 과하다 */
  .tight { padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem); }
</style>
