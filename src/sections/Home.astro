---
import { ext } from '../i18n/utils';
// 홈 (v3 §3.1) — 서비스 3 + 근거. 히어로 철학 문구는 푸터로, 제품 카드는 없다.
import Base from '../layouts/Base.astro';
import { site, servicePages, bookingHref } from '../config/site';
import { content } from '../i18n/content';

const tr = content.ko;
const c = tr.home;
const hrefOf = (key: string) => servicePages.find((s) => s.key === key)?.href ?? '/contact/';
---

<Base title={c.title} description={c.description} lang="ko" rawTitle>
  <section class="hero band-ink">
    <div class="wrap hero-copy">
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={bookingHref()}>{tr.common.book} <span class="arrow">&rarr;</span></a>
        <a class="btn btn-ghost" href={`tel:${site.contactPhoneIntl}`}>{tr.common.call} {site.contactPhone}</a>
      </div>
      <p class="eyebrow fixed">{tr.common.fixedLine}</p>
    </div>
  </section>

  {/* 작업 방식은 서비스 위(2026-09-07, 개선 작업 E): 세 서비스를 묶는 유일한 원칙이라 카드보다 먼저 보인다. 영문 태그라인은 푸터 문구 그대로. */}
  <section class="section wrap method tight">
    <span class="eyebrow">{c.methodEyebrow}</span>
    <p class="tagline">{tr.footer.tagline}</p>
    <p class="lede">{c.method}</p>
  </section>

  <section class="section wrap">
    <div class="head">
      <span class="eyebrow">{c.servicesEyebrow}</span>
      <h2>{c.servicesH2}</h2>
    </div>
    <div class="cards">
      {c.cards.map((card) => (
        <a class="card" href={hrefOf(card.key)} {...ext(hrefOf(card.key))}>
          <span class="eyebrow situation">{card.situation}</span>
          <h3>{card.name}</h3>
          <p class="terms">{card.terms}</p>
          <p class="deliverable">{card.deliverable}</p>
          <p class="relation">{card.relation}</p>
          <span class="more">자세히 <span class="arrow">&rarr;</span></span>
        </a>
      ))}
    </div>
    {/* v4(2026-09-11): 심사 프레임 밖의 둘은 작은 카드 — 서비스로는 유지, 무게만 내린다. */}
    <div class="head others-head">
      <span class="eyebrow">{c.othersEyebrow}</span>
      <h2 class="h3">{c.othersH2}</h2>
    </div>
    <div class="cards others">
      {c.others.map((card) => (
        <a class="card minor" href={hrefOf(card.key)} {...ext(hrefOf(card.key))}>
          <h3>{card.name}</h3>
          <p class="terms">{card.terms}</p>
          <p class="deliverable">{card.deliverable}</p>
          <p class="relation">{card.relation}</p>
          <span class="more">자세히 <span class="arrow">&rarr;</span></span>
        </a>
      ))}
    </div>
    <p class="scan"><a href={c.scanHref}>{c.scanLine} &rarr;</a></p>
    <p class="vat eyebrow">{tr.common.vatNote}</p>
  </section>

  <section class="section wrap work tight">
    <span class="eyebrow">{c.workEyebrow}</span>
    <p>{c.workLine}</p>
    <dl class="facts">
      {c.workItems.map((w) => (
        <div class="row">
          <dt><a href={w.href} {...ext(w.href)}>{w.name} &rarr;</a></dt>
          <dd>{w.proof}</dd>
        </div>
      ))}
    </dl>
    <a class="btn btn-ghost" href="/work/">{c.workLink} <span class="arrow">&rarr;</span></a>
  </section>

  <section class="cta-band band-ink">
    <div class="wrap cta-inner">
      <h2>{c.closingH2}</h2>
      <div class="cta-row">
        <a class="btn btn-primary" href={bookingHref()}>{tr.common.book} <span class="arrow">&rarr;</span></a>
        <a class="btn btn-ghost" href={`tel:${site.contactPhoneIntl}`}>{site.contactPhone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3.5rem, 2rem + 8vw, 7rem); }
  .hero-copy { display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start; max-width: 60ch; }
  .hero h1 { max-width: 24ch; }
  .cta-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .fixed { margin-top: 0.5rem; }
  .head { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem; max-width: var(--measure); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; }
  .card {
    display: flex; flex-direction: column; gap: 0.6rem; padding: 1.6rem;
    border: 1px solid var(--hairline); border-radius: var(--radius); background: var(--color-mist);
    text-decoration: none; color: inherit; transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover { border-color: var(--color-recovered); transform: translateY(-2px); }
  .situation { color: var(--color-recovered); }
  .others-head { margin-top: 2.5rem; margin-bottom: 1.25rem; }
  .others-head .h3 { font-size: var(--step-1); }
  .card.minor { padding: 1.2rem 1.4rem; background: transparent; }
  .card.minor h3 { font-size: var(--step-0); }
  .terms { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-ink); }
  .deliverable { color: var(--color-slate); }
  .more { margin-top: 0.4rem; font-weight: 600; font-size: var(--step--1); }
  .more .arrow { transition: transform 0.15s ease; display: inline-block; }
  .card:hover .more .arrow { transform: translateX(3px); }
  .vat { margin-top: 1.25rem; }
  .facts { margin: 0.25rem 0 0; border-top: 1px solid var(--hairline); width: 100%; max-width: var(--measure); }
  .row { display: grid; grid-template-columns: 15rem 1fr; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--hairline); }
  dt { font-size: var(--step-0); font-weight: 600; }
  dt a { color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  dd { margin: 0; font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-slate); }
  .method .tagline { margin-top: 0.75rem; font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-slate); }
  .method .lede { margin-top: 0.5rem; max-width: var(--measure); }
  .relation { color: var(--color-slate); font-size: var(--step--1); line-height: 1.55; }
  .scan { margin-top: 1.25rem; }
  .scan a { color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  .work { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
  /* 근거·작업 방식·만든 것들은 짧은 절이라 기본 section 여백이 과하다 */
  .tight { padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem); }
  .cta-band { padding-block: var(--section-y); }
  .cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
