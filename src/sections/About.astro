---
// 회사 소개 (v3 §3.6) — 대표 경력 중심. 회사 정보표는 실사에서 확인되는 것만.
import Base from '../layouts/Base.astro';
import { content } from '../i18n/content';

const c = content.ko.about;
---

<Base title={c.title} description={c.description} lang="ko">
  <section class="hero band-ink section">
    <div class="wrap head">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </section>

  <section class="section wrap body">
    {c.sections.map((s) => (
      <div class="block">
        <h2>{s.h}</h2>
        {s.p.map((para) => <p>{para}</p>)}
      </div>
    ))}
    <a class="founder" href="/founder/">{c.founderCta} &rarr;</a>
  </section>

  <section class="section wrap">
    <h2 class="facts-h">{c.factsTitle}</h2>
    <dl class="facts">
      {c.facts.map((f) => (
        <div class="row">
          <dt>{f.k}</dt>
          <dd>{f.v}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: 1rem; max-width: var(--measure); }
  .body { display: flex; flex-direction: column; gap: 2.5rem; max-width: var(--measure); }
  .block { display: flex; flex-direction: column; gap: 0.75rem; }
  .block h2 { font-size: var(--step-1); }
  .block p { color: var(--color-slate); line-height: 1.7; margin: 0; }
  .facts-h { font-size: var(--step-1); margin-bottom: 1.25rem; }
  .facts { margin: 0; border-top: 1px solid var(--hairline); max-width: var(--measure); }
  .row { display: grid; grid-template-columns: 13rem 1fr; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid var(--hairline); }
  dt { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-slate); }
  dd { margin: 0; font-size: var(--step-0); }
  .founder { align-self: flex-start; color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); font-weight: 600; }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
