---
import { ext } from '../i18n/utils';
// 요구사항 대조 엔진 페이지 (2026-09-11). 회사 포장용이되 없는 것을 있다고 하지 않는다 — 수치마다 잣대, 잰 적 없는
// 도메인은 "측정치 없음". 접수 창구는 문의 폼 재사용(주제 '기타') — 전용 주제는 백엔드 TOPIC_LABELS 와 함께 바꿔야 한다.
import Base from '../layouts/Base.astro';
import { bookingHref } from '../config/site';
import { content } from '../i18n/content';

const c = content.ko.engine;
---

<Base title={c.title} description={c.description} lang="ko">
  <section class="hero band-ink section">
    <div class="wrap head">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </section>

  {/* 10-07 오너: 작동 방식(네 단계)을 히어로 바로 다음에 */}
  <section class="section wrap block">
    <h2>{c.stepsH}</h2>
    <ol class="steps">
      {c.steps.map((s, i) => (
        <li>
          {/* 10-07 오너: 단계마다 번호(홈 시스템 칸의 01·02 와 같은 꼴) */}
          <span class="eyebrow">{String(i + 1).padStart(2, '0')} · {s.name}</span>
          <p>{s.text}</p>
          <p class="measure">{s.measure} {'link' in s && <a href={s.link.href} {...ext(s.link.href)}>{s.link.label} &rarr;</a>}</p>
        </li>
      ))}
    </ol>
    {'layers' in c && <ul class="plain layers">{c.layers.map((l) => <li>{l}</li>)}</ul>}
  </section>

  {/* v5(2026-09-14) 허브 — 10-07 오너: 작동 방식(네 단계) 다음으로 */}
  <section class="section wrap block">
    <h2>{c.servicesH}</h2>
    <div class="cards">
      {c.services.map((s) => (
        <a class="card" href={s.href} {...ext(s.href)}>
          <span class="name">{s.name}</span>
          <p>{s.what}</p>
          <p class="measured">{s.measured}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap block intake" id="intake">
    <h2>{c.intakeH}</h2>
    <p>{c.intake}</p>
    <a class="btn btn-primary" href={c.intakeHref}>{c.intakeCta} <span class="arrow">&rarr;</span></a>
    <p class="min">{c.intakeNote}</p>
  </section>

  <section class="section wrap block">
    <h2>{c.sourcesH}</h2>
    <ul class="sources">{c.sources.map((s) => <li><a href={s.href} {...ext(s.href)}>{s.label} &rarr;</a></li>)}</ul>
    <a class="btn btn-secondary cta" href={bookingHref()}>{c.cta} <span class="arrow">&rarr;</span></a>
  </section>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: 1rem; max-width: var(--measure); }
  /* 09-14: 기본 section 여백(위아래 112px)이 섹션 사이를 224px 로 벌렸다 — 서비스 페이지 .block 과 같은 값으로 */
  .block { display: flex; flex-direction: column; gap: 1rem; max-width: var(--measure); padding-block: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .block h2 { font-size: var(--step-1); margin: 0; }
  .block p { color: var(--color-slate); line-height: 1.7; margin: 0; }
  /* 10-07 오너: 단계를 표처럼 붙이지 않고 하나씩 띄운 박스로 — 아래 '하는 일' 카드와 같은 테두리·간격 */
  .steps { margin: 0; padding: 0; list-style: none; display: grid; gap: 1rem; }
  /* 09-14: 칸·카드는 페이지 배경(vellum)과 구분되게 mist — 홈 시스템 칸과 같은 조합 */
  .steps li { background: var(--color-mist); border: 1px solid var(--hairline); border-radius: var(--radius); padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .steps .measure { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-ink); }
  .steps .measure a, .sources a { color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  .plain { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.5rem; color: var(--color-slate); line-height: 1.6; }
  .min { font-size: var(--step--1); color: var(--color-slate); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .card { display: flex; flex-direction: column; gap: 0.4rem; padding: 1rem 1.1rem; border: 1px solid var(--hairline); border-radius: var(--radius); text-decoration: none; color: inherit; background: var(--color-mist); }
  .card .name { font-weight: 600; color: var(--color-ink); }
  .card .measured { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-ink); }
  .layers { margin-top: 0.25rem; }
  .intake .btn { align-self: flex-start; }
  .sources { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .cta { align-self: flex-start; margin-top: 0.5rem; }
</style>
