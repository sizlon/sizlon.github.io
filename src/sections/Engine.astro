---
// 문서 검증 엔진 페이지 (2026-09-11). 회사 포장용이되 없는 것을 있다고 하지 않는다 — 수치마다 잣대, 잰 적 없는
// 도메인은 "측정치 없음". 접수 창구는 문의 폼 재사용(주제 '기타') — 전용 주제는 백엔드 TOPIC_LABELS 와 함께 바꿔야 한다.
import Base from '../layouts/Base.astro';
import { bookingHref } from '../config/site';
import { content } from '../i18n/content';

const c = content.ko.engine;
---

<Base title={c.title} description={c.description} lang="ko">
  <section class="hero band-ink section">
    <div class="wrap head">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </section>

  <section class="section wrap block">
    <h2>{c.stepsH}</h2>
    <ol class="steps">
      {c.steps.map((s) => (
        <li>
          <span class="eyebrow">{s.name}</span>
          <p>{s.text}</p>
          <p class="measure">{s.measure} {'link' in s && <a href={s.link.href}>{s.link.label} &rarr;</a>}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap block">
    <h2>{c.trustH}</h2>
    <ul class="plain">{c.trust.map((t) => <li>{t}</li>)}</ul>
    <h3>{c.evidenceH}</h3>
    <p class="note">{c.evidenceNote}</p>
    <ul class="plain evidence">
      {c.evidence.map((e) => <li>{e.text} <a href={e.href} rel="noopener">출처 &rarr;</a></li>)}
    </ul>
  </section>

  <section class="section wrap block">
    <h2>{c.notH}</h2>
    <ul class="plain">{c.nots.map((n) => <li>{n}</li>)}</ul>
  </section>

  <section class="section wrap block">
    <h2>{c.servicesH}</h2>
    <div class="cards">
      {c.services.map((s) => (
        <a class="card" href={s.href}>
          <span class="name">{s.name}</span>
          <p>{s.what}</p>
          <p class="measured">{s.measured}</p>
        </a>
      ))}
    </div>
    <h3>{c.goldenH}</h3>
    <p class="golden">{c.golden}</p>
  </section>

  <section class="section wrap block intake" id="intake">
    <h2>{c.intakeH}</h2>
    <p>{c.intake}</p>
    <a class="btn btn-primary" href={c.intakeHref}>{c.intakeCta} <span class="arrow">&rarr;</span></a>
    <p class="min">{c.intakeNote}</p>
  </section>

  <section class="section wrap block">
    <h2>{c.sourcesH}</h2>
    <ul class="sources">{c.sources.map((s) => <li><a href={s.href}>{s.label} &rarr;</a></li>)}</ul>
    <a class="btn btn-secondary cta" href={bookingHref()}>{c.cta} <span class="arrow">&rarr;</span></a>
  </section>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: 1rem; max-width: var(--measure); }
  .block { display: flex; flex-direction: column; gap: 1rem; max-width: var(--measure); }
  .block h2 { font-size: var(--step-1); margin: 0; }
  .block h3 { font-size: var(--step-0); margin: 1rem 0 0; }
  .block p { color: var(--color-slate); line-height: 1.7; margin: 0; }
  .steps { margin: 0; padding: 0; list-style: none; display: grid; gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); border-radius: var(--radius); overflow: hidden; }
  .steps li { background: var(--color-vellum); padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .steps .measure { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-ink); }
  .steps .measure a, .evidence a, .sources a { color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  .plain { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.5rem; color: var(--color-slate); line-height: 1.6; }
  .note, .min { font-size: var(--step--1); color: var(--color-slate); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .card { display: flex; flex-direction: column; gap: 0.4rem; padding: 1rem 1.1rem; border: 1px solid var(--hairline); border-radius: var(--radius); text-decoration: none; color: inherit; background: var(--color-vellum); }
  .card .name { font-weight: 600; color: var(--color-ink); }
  .card .measured { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-ink); }
  .golden { color: var(--color-slate); line-height: 1.7; }
  .intake .btn { align-self: flex-start; }
  .sources { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .cta { align-self: flex-start; margin-top: 0.5rem; }
</style>
