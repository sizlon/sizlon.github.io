---
import { ext } from '../i18n/utils';
// 서비스 페이지 공통 본문 (v3 §3.2~3.4). 세 서비스가 같은 뼈대를 쓰고 블록은
// 내용이 비면 렌더하지 않는다. rtm 은 `brief` 로 짧은 판(제목·부제·가격·근거·CTA).
import Base from '../layouts/Base.astro';
import { site, servicePages, bookingHref, ORG_ID } from '../config/site';
import { content, type ServiceKey } from '../i18n/content';

interface Props { service: ServiceKey }
const { service } = Astro.props;
const tr = content.ko;
const c = tr.services[service];
const brief = 'brief' in c && c.brief;
const topic = servicePages.find((s) => s.key === service)?.topic ?? service;
const toolLine = 'toolLine' in c ? c.toolLine : '';
const principles = 'principles' in c ? c.principles : [];
const principlesH = 'principlesH' in c ? c.principlesH : '';
const minLine = 'minLine' in c ? c.minLine : '';
const heroProof = 'heroProof' in c ? c.heroProof : [];
const heroProofLink = 'heroProofLink' in c ? c.heroProofLink : null;
const engineLink = 'engineLink' in c ? c.engineLink : null;
const termsH = 'termsH' in c ? c.termsH : '';
const terms = 'terms' in c ? c.terms : [];
const notesH = 'notesH' in c ? c.notesH : '';
const notes = 'notes' in c ? c.notes : [];
// 무료 스캔 절(검색 진단만, 2026-09-07 개선 작업 B) — content 에 scan 키가 있을 때만.
const scan = 'scan' in c ? c : null;
// '이 다음에 보통 필요한 것'(개선 작업 A) — brief 와 무관하게 항상 렌더: RTM 짧은 판에서도 다른 두 서비스로 가는 길은 있어야 한다.
const next = 'next' in c ? c.next : [];
// 하는 것/하지 않는 것·가격표(2026-09-14, rtm) — content 에 키가 있을 때만.
const scope = 'scopeH' in c ? c : null;
const priceTable = 'priceTableH' in c ? c : null;
const priceLink = 'priceLink' in c ? c.priceLink : null;
const nextH = 'nextH' in c ? c.nextH : '';
// 직접 하면 vs 맡기면(2026-09-15, rtm) — 구입 가치를 히어로 바로 밑에. 수치는 content.ko.proof.rtmEffort(추정).
const valueLine = 'valueLine' in c ? c.valueLine : null;
const effort = 'effortH' in c ? c : null;

// Service + Offer JSON-LD (2026-09-06). 숫자는 content 의 offer(표시 price 와 같은 값) 에서만.
const url = new URL(Astro.url.pathname, Astro.site).href;
const offer = c.offer;
// FAQPage(2026-09-07, 개선 작업 G) — 화면에 FAQ 가 있는 페이지만(brief 는 FAQ 를 안 그린다).
const faqSchema = !brief && c.faq.length > 0
  ? [{
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: c.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }]
  : [];
const serviceSchema = {
  '@type': 'Service',
  '@id': `${url}#service`,
  name: c.title,
  serviceType: c.title,
  description: c.description,
  url,
  provider: { '@id': ORG_ID },
  areaServed: 'KR',
  offers: {
    '@type': 'Offer',
    url,
    priceCurrency: 'KRW',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      priceCurrency: 'KRW',
      minPrice: offer.minPrice,
      maxPrice: offer.maxPrice,
      valueAddedTaxIncluded: false,
      ...('unitCode' in offer ? { unitCode: offer.unitCode } : {}),
      ...('unitText' in offer ? { unitText: offer.unitText } : {}),
    },
  },
};
---

<Base title={c.title} description={c.description} lang="ko" schema={[serviceSchema, ...faqSchema]}>
  <section class="hero band-ink">
    <div class="wrap head">
      {'crumb' in c ? <nav class="crumb eyebrow" aria-label="위치"><a href={c.crumb.href}>{c.crumb.label}</a> <span aria-hidden="true">›</span> {c.crumb.here}</nav> : <span class="eyebrow">{c.eyebrow}</span>}
      <h1>{c.h1}</h1>
      <p class="lede">{c.sub}</p>
      <p class="price">{c.price}</p>
      {c.priceNote && <p class="price-note">{c.priceNote}{priceLink && <> <a class="price-link" href={priceLink.href}>{priceLink.label} &rarr;</a></>}</p>}
      {valueLine && (
        <a class="value" href={valueLine.href}>
          <span class="value-side"><span class="value-k">{valueLine.direct}</span><span class="value-v">{valueLine.directVal}</span></span>
          <span class="value-arrow" aria-hidden="true">&rarr;</span>
          <span class="value-side"><span class="value-k">{valueLine.ours}</span><span class="value-v ours">{valueLine.oursVal}</span></span>
          <span class="value-note">{valueLine.note} · {valueLine.label} &darr;</span>
        </a>
      )}
      {heroProof.length > 0 && (
        <div class="proof">
          {heroProof.map((l) => <p>{l}</p>)}
          {heroProofLink && <a href={heroProofLink.href} {...ext(heroProofLink.href)}>{heroProofLink.label} &rarr;</a>}
          {engineLink && <a href={engineLink.href}>{engineLink.label} &rarr;</a>}
        </div>
      )}
      <p class="vat eyebrow">{tr.common.vatNote}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={bookingHref(topic)}>{tr.common.book} <span class="arrow">&rarr;</span></a>
        <a class="btn btn-ghost" href={`tel:${site.contactPhoneIntl}`}>{tr.common.call} {site.contactPhone}</a>
      </div>
      {scan && <p class="scan-link"><a href="#scan">{scan.scanLink} &rarr;</a></p>}
    </div>
  </section>

  {!brief && effort && (
    <section class="section wrap block effort" id="effort">
      <h2>{effort.effortH}</h2>
      <p class="effort-lead">{effort.effortLead}</p>
      <div class="effort-cards">
        {effort.effortCards.map((k, i) => (
          <div class:list={['effort-card', i === 1 && 'ours']}>
            <span class="eyebrow">{k.label}</span>
            <span class="effort-big">{k.big}</span>
            <span class="effort-cost">{k.cost}</span>
            <span class="effort-sub">{k.sub}</span>
          </div>
        ))}
      </div>
      <div class="table-scroll">
        <table class="price-table steps-table">
          <caption>{effort.effortCaption}</caption>
          <thead><tr>{effort.effortStepsHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {effort.effortSteps.map(([what, days]) => <tr><td class="what">{what}</td><td>{days}</td></tr>)}
          </tbody>
          <tfoot><tr><th scope="row">{effort.effortStepsTotal}</th><td>{effort.effortCards[0].big}</td></tr></tfoot>
        </table>
      </div>
      <div class="table-scroll">
        <table class="price-table">
          <caption>{effort.effortTable.caption}</caption>
          <thead><tr>{effort.effortTable.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {effort.effortTable.rows.map((r) => (
              <tr>{r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td class:list={[i === 3 && 'ours']}>{cell}</td>))}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="effort-basis">{effort.effortBasis}</p>
    </section>
  )}

  {!brief && c.who.length > 0 && (
    <section class="section wrap block">
      <h2>{c.whoH}</h2>
      <ul class="plain">{c.who.map((w) => <li>{w}</li>)}</ul>
    </section>
  )}

  {!brief && c.how.length > 0 && (
    <section class="section wrap block" id="how">
      <h2>{c.howH}</h2>
      <ol class="steps">
        {c.how.map((s) => (
          <li>
            <span class="eyebrow">{s.name}</span>
            <p>{s.text}</p>
            {'items' in s && <ol class="sub">{s.items.map((it) => <li>{it}</li>)}</ol>}
            {'after' in s && <p>{s.after}</p>}
            {'note' in s && <p class="note">{s.note} {'link' in s && <a href={s.link.href} {...ext(s.link.href)}>{s.link.label} &rarr;</a>}</p>}
          </li>
        ))}
      </ol>
      {toolLine && <p class="tool">{toolLine}</p>}
    </section>
  )}

  {!brief && scope && (
    <section class="section wrap block scope" id="scope">
      <h2>{scope.scopeH}</h2>
      <div class="scope-grid">
        <div class="scope-col">
          <h3>{scope.scopeDo.h}</h3>
          {scope.scopeDo.groups.map((g) => (
            <div class="scope-group">
              <span class="eyebrow">{g.label}</span>
              <ul class="plain">{g.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
        <div class="scope-col dont">
          <h3>{scope.scopeDont.h}</h3>
          <ul class="plain">{scope.scopeDont.items.map((it) => <li>{it}</li>)}</ul>
        </div>
      </div>
      {minLine && <p class="min">{minLine}</p>}
    </section>
  )}

  {'systemH' in c && (
    <section class="section wrap block" id="system">
      <h2>{c.systemH}</h2>
      <ul class="plain">{c.system.map((l) => <li>{l}</li>)}</ul>
    </section>
  )}

  {notes.length > 0 && (
    <section class="section wrap block">
      <h2>{notesH}</h2>
      <ul class="notes">
        {notes.map((n) => (
          <li>
            <a href={n.href} {...ext(n.href)}>{n.label} &rarr;</a>
            <p>{n.line}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {!brief && c.deliverables.length > 0 && (
    <section class="section wrap block">
      <h2>{c.deliverH}</h2>
      <ul class="plain">{c.deliverables.map((d) => <li>{d}</li>)}</ul>
      {'deliverLink' in c && <p class="note"><a href={c.deliverLink.href}>{c.deliverLink.label} &rarr;</a> {c.deliverLink.line}</p>}
      {c.options.length > 0 && (
        <div class="options">
          <span class="eyebrow">{c.optionH}</span>
          <ul class="plain">{c.options.map((o) => <li>{o}</li>)}</ul>
        </div>
      )}
    </section>
  )}

  {!brief && priceTable && (
    <section class="section wrap block" id="price">
      <h2>{priceTable.priceTableH}</h2>
      <div class="table-scroll">
        <table class="price-table">
          <caption>{priceTable.priceTable.caption}</caption>
          <thead><tr>{priceTable.priceTable.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {priceTable.priceTable.rows.map((r) => (
              <tr>{r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="plain">{priceTable.priceTable.notes.map((n) => <li>{n}</li>)}</ul>
    </section>
  )}

  {scan && (
    <section class="section wrap block scan" id="scan">
      <h2>{scan.scanH}</h2>
      <p>{scan.scan}</p>
      <a class="btn btn-primary" href={scan.scanHref}>{scan.scanCta} <span class="arrow">&rarr;</span></a>
      <p class="min">{scan.scanSub}</p>
    </section>
  )}

  {terms.length > 0 && (
    <section class="section wrap block">
      <h2>{termsH}</h2>
      <ul class="plain">{terms.map((t) => <li>{t}</li>)}</ul>
    </section>
  )}

  {principles.length > 0 && (
    <section class="section wrap block" id="principles">
      <h2>{principlesH}</h2>
      <ul class="plain">{principles.map((p) => <li>{p}</li>)}</ul>
      {minLine && <p class="min">{minLine}</p>}
    </section>
  )}

  {!brief && c.faq.length > 0 && (
    <section class="section wrap block">
      <h2>{c.faqH}</h2>
      <dl class="faq">
        {c.faq.map((f) => (
          <div class="qa">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {next.length > 0 && (
    <section class="section wrap block">
      <h2>{nextH}</h2>
      <ul class="notes">
        {next.map((n) => (
          <li>
            <a href={n.href} {...ext(n.href)}>{n.label} &rarr;</a>
            <p>{n.line}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="cta-band band-ink">
    <div class="wrap cta-inner">
      <h2>{c.cta}</h2>
      <div class="cta-row">
        <a class="btn btn-primary" href={bookingHref(topic)}>{tr.common.book} <span class="arrow">&rarr;</span></a>
        <a class="btn btn-ghost" href={`tel:${site.contactPhoneIntl}`}>{site.contactPhone}</a>
      </div>
      {scan && <p class="cross"><a href={scan.scanHref}>{scan.scanLink} &rarr;</a></p>}
    </div>
  </section>
</Base>

<style>
  .crumb a { color: var(--color-mist); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  .hero { padding-block: clamp(3rem, 2rem + 5vw, 5.5rem); }
  .head { display: flex; flex-direction: column; gap: 1rem; max-width: var(--measure); align-items: flex-start; }
  .price { font-family: var(--font-mono); font-size: var(--step-1); color: var(--color-recovered); }
  .price-note { color: var(--slate-on-dark); }
  .cta-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .block { display: flex; flex-direction: column; gap: 1rem; max-width: var(--measure); padding-block: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .block h2 { font-size: var(--step-2); }
  .plain { margin: 0; padding-left: 1.2em; display: flex; flex-direction: column; gap: 0.5rem; }
  .plain li { color: color-mix(in srgb, var(--color-ink) 85%, var(--color-vellum)); }
  .steps { margin: 0; padding: 0; list-style: none; display: grid; gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); border-radius: var(--radius); overflow: hidden; }
  .steps li { background: var(--color-mist); padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .tool { color: var(--color-slate); }
  .steps .sub { margin: 0.25rem 0 0; padding-left: 1.4rem; display: grid; gap: 0.35rem; }
  .steps .sub li { background: none; padding: 0; display: list-item; }
  .steps .note { color: var(--color-slate); font-size: var(--step--1); }
  .steps .note a { color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  .proof { display: flex; flex-direction: column; gap: 0.35rem; margin-top: 0.25rem; max-width: 60ch; }
  .proof p { color: var(--slate-on-dark); font-size: var(--step--1); line-height: 1.6; }
  .proof a { color: var(--color-mist); text-decoration: none; border-bottom: 1px solid var(--color-recovered); font-size: var(--step--1); align-self: flex-start; }
  .options { margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .proof .plain li { font-family: var(--font-body); }
  .vat { margin-top: 0.25rem; }
  .min { color: var(--color-slate); }
  .faq { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .qa { display: flex; flex-direction: column; gap: 0.3rem; padding-bottom: 1rem; border-bottom: 1px solid var(--hairline); }
  dt { font-weight: 600; }
  dd { margin: 0; color: color-mix(in srgb, var(--color-ink) 82%, var(--color-vellum)); }
  .cta-band { padding-block: var(--section-y); }
  .cta-inner { display: flex; flex-direction: column; gap: 1.5rem; align-items: flex-start; }
  .cta-inner h2 { font-size: var(--step-2); max-width: var(--measure); }
  .scan-link { margin-top: 0.25rem; font-size: var(--step--1); }
  .scan-link a { color: var(--color-mist); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  .scan .btn { align-self: flex-start; }
  .cross { color: var(--slate-on-dark); }
  .cross a { color: var(--color-mist); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  .price-link { color: var(--color-mist); text-decoration: none; border-bottom: 1px solid var(--color-recovered); white-space: nowrap; }
  .scope-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); border-radius: var(--radius); overflow: hidden; }
  .scope-col { background: var(--color-mist); padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .scope-col h3 { font-size: var(--step-1); }
  .scope-group { display: flex; flex-direction: column; gap: 0.5rem; }
  .table-scroll { overflow-x: auto; max-width: 100%; }
  /* 테두리 표(2026-09-15): 바깥 테두리·셀 사이 선·머리 행 배경. caption 은 표 밖 위에 둔다 */
  .price-table { border-collapse: separate; border-spacing: 0; width: 100%; min-width: 34rem; font-size: var(--step--1); border: 1px solid var(--hairline); border-radius: var(--radius); overflow: hidden; }
  .price-table caption { text-align: left; color: var(--color-slate); padding-bottom: 0.5rem; }
  .price-table th, .price-table td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--hairline); border-right: 1px solid var(--hairline); white-space: nowrap; background: var(--color-mist); }
  .price-table tr > :last-child { border-right: 0; }
  .price-table tbody tr:last-child > * { border-bottom: 0; }
  .price-table thead th { font-weight: 600; color: var(--color-slate); background: color-mix(in srgb, var(--color-ink) 5%, var(--color-mist)); }
  .price-table td { font-family: var(--font-mono); }
  .value { display: grid; grid-template-columns: auto auto auto; align-items: end; gap: 0.4rem 1rem; margin-top: 0.5rem; padding: 1rem 1.25rem; border: 1px solid var(--color-recovered); border-radius: var(--radius); text-decoration: none; color: inherit; max-width: 100%; }
  .value-side { display: flex; flex-direction: column; gap: 0.15rem; }
  .value-k { font-size: var(--step--1); color: var(--slate-on-dark); }
  .value-v { font-family: var(--font-mono); font-size: var(--step-1); color: var(--color-mist); }
  .value-v.ours { color: var(--color-recovered); }
  .value-arrow { color: var(--slate-on-dark); font-size: var(--step-1); padding-bottom: 0.1rem; }
  .value-note { grid-column: 1 / -1; font-size: var(--step--1); color: var(--slate-on-dark); }
  @media (max-width: 40rem) { .value { grid-template-columns: 1fr; } .value-arrow { transform: rotate(90deg); justify-self: start; } }
  .effort-lead { color: color-mix(in srgb, var(--color-ink) 85%, var(--color-vellum)); }
  .effort-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); border-radius: var(--radius); overflow: hidden; }
  .effort-card { background: var(--color-mist); padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .effort-card.ours { background: color-mix(in srgb, var(--color-recovered) 14%, var(--color-mist)); }
  .effort-big { font-family: var(--font-mono); font-size: var(--step-3, 2rem); line-height: 1.1; }
  .effort-cost { font-family: var(--font-mono); font-size: var(--step-1); }
  .effort-card.ours .effort-cost { font-weight: 600; }
  .effort-sub { color: var(--color-slate); font-size: var(--step--1); }
  .steps-table { min-width: 0; }
  .steps-table td.what { white-space: normal; font-family: var(--font-body); }
  .steps-table tfoot > * > * { font-weight: 600; border-bottom: 0; }
  .steps-table tbody tr:last-child > * { border-bottom: 1px solid var(--hairline); }
  .price-table td.ours { font-weight: 600; }
  .effort-basis { color: var(--color-slate); font-size: var(--step--1); line-height: 1.6; }
  .notes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .notes a { color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); font-weight: 600; }
  .notes p { color: var(--color-slate); margin-top: 0.3rem; font-size: var(--step--1); }
</style>
