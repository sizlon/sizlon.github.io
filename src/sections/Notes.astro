---
// 노트 목록 (2026-09-07, 개선 작업 C) — 컬렉션 `notes` 에서 언어별로 자동 생성, 날짜 내림차순.
// /notes/ (ko) ↔ /en/notes/ (en) 는 hreflang 쌍. 항목 = 제목·날짜·서비스·설명. 새 컴포넌트 없음.
import Base from '../layouts/Base.astro';
import { content, type Lang } from '../i18n/content';
import { getCollection } from 'astro:content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = content[lang];
const c = tr.notesIndex;
const all = await getCollection('notes');
const entries = all
  .filter((e) => (lang === 'en') === e.id.startsWith('en/'))
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const hrefOf = (id: string) => (lang === 'en' ? `/en/notes/${id.slice(3)}/` : `/notes/${id}/`);
const hreflang = { ko: '/notes/', en: '/en/notes/' };
---

<Base title={c.title} description={c.description} lang={lang} schema={[]} hreflang={hreflang}>
  <section class="hero band-ink section">
    <div class="wrap head">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </section>

  <section class="section wrap">
    <ul class="list">
      {entries.map((e) => (
        <li>
          <span class="meta">{e.data.date} · {tr.nav[e.data.service]}</span>
          <h2><a href={hrefOf(e.id)}>{e.data.title} &rarr;</a></h2>
          <p>{e.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: 1rem; max-width: var(--measure); }
  .head .lede { color: var(--slate-on-dark); }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2rem; max-width: var(--measure); }
  .list li { display: flex; flex-direction: column; gap: 0.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--hairline); }
  .meta { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-slate); }
  .list h2 { font-size: var(--step-1); }
  .list h2 a { color: var(--color-ink); text-decoration: none; border-bottom: 1px solid var(--color-recovered); }
  .list p { color: color-mix(in srgb, var(--color-ink) 85%, var(--color-vellum)); line-height: 1.7; }
</style>
