---
// Self-hosted variable fonts (no third-party runtime calls). Family names used in global.css.
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
// Korean (Hangul) coverage — Latin display/body fonts are Latin-only, so
// Pretendard is the per-glyph Hangul fallback in the font stacks.
import '@fontsource/pretendard/400.css';
import '@fontsource/pretendard/500.css';
import '@fontsource/pretendard/600.css';
import '@fontsource/pretendard/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, ORG_ID, FOUNDER_ID } from '../config/site';
import type { Lang } from '../i18n/content';
import { t, logicalPath } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** 색인 제외 — 404 등. sitemap 제외(astro.config.mjs filter)와 쌍. */
  noindex?: boolean;
  /** 제목을 그대로 쓴다(홈처럼 이미 브랜드가 들어간 제목). */
  rawTitle?: boolean;
  /** 페이지 고유 JSON-LD 노드(Service·Person 등). 회사 노드·BreadcrumbList 는 여기서 붙인다. */
  schema?: Record<string, unknown>[];
  /** 번역 짝이 있는 페이지의 hreflang(경로). 홈은 자동, 그 외엔 노트처럼 짝이 있는 페이지만 넘긴다. */
  hreflang?: { ko: string; en: string };
}
const { title, description, lang = 'ko', noindex = false, rawTitle = false, schema = [], hreflang } = Astro.props;
const fullTitle = rawTitle ? title : `${title} — ${lang === 'en' ? 'Sizlon' : '시즐론'}`;
const tr = t(lang);
// hreflang 은 홈 한 쌍(/ ↔ /en/)에만. 다른 페이지는 한국어만 있다. x-default 는 ko.
const logical = logicalPath(Astro.url);
const isHome = logical === '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const homeKo = new URL('/', Astro.site);
const homeEn = new URL('/en/', Astro.site);
// hreflang 쌍: 홈(/ ↔ /en/)은 자동, 나머지는 페이지가 넘긴 짝만. x-default 는 ko.
const pair = isHome ? { ko: homeKo.href, en: homeEn.href } : hreflang ? { ko: new URL(hreflang.ko, Astro.site).href, en: new URL(hreflang.en, Astro.site).href } : null;
const ogImage = new URL('/og-v4.png', Astro.site).href;

// JSON-LD — 회사 노드 하나를 모든 페이지가 공유하고(@id 로 참조), 홈이 아닌 페이지에는
// BreadcrumbList, 페이지 고유 노드(Service·Person)는 `schema` prop 으로 받는다 (2026-09-06).
const org = {
  '@type': 'ProfessionalService',
  '@id': ORG_ID,
  name: '시즐론',
  alternateName: 'Sizlon Inc.',
  url: 'https://sizlon.io/',
  logo: 'https://sizlon.io/logo/sizlon-logo.svg',
  image: ogImage,
  description: '감리 대비표 사전 검토, 입찰 서류 검증(미리보아), 데이터 피드, 검색 품질 진단. 심사받기 전에 지적당할 곳을 먼저 찾고, 어떻게 재는지와 얼마나 틀리는지를 공개합니다. 매체 7,000곳·일 20만 건 수집·색인 인프라를 구축·운영한 엔지니어가 직접 수행합니다.',
  founder: { '@type': 'Person', '@id': FOUNDER_ID, name: '이광연', alternateName: 'Kwangyeon Lee' },
  // 2026-09-05 전화 규칙 철회(v3 §3.7): 검색 결과의 통화 버튼이 원하는 신호다.
  telephone: site.contactPhoneIntl,
  email: site.contactEmail,
  openingHours: 'Mo-Fr 09:00-18:00',
  areaServed: 'KR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '원효로 189-7, 302호',
    addressLocality: '용산구',
    addressRegion: '서울특별시',
    addressCountry: 'KR',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.contactPhoneIntl,
    email: site.contactEmail,
    contactType: 'sales',
    availableLanguage: ['ko', 'en'],
  },
  subOrganization: { '@type': 'Organization', name: 'Miriboa', url: 'https://miriboa.sizlon.io' },
};
const breadcrumb = !isHome && !noindex ? [{
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'en' ? 'Sizlon' : '시즐론', item: (lang === 'en' ? homeEn : homeKo).href },
    { '@type': 'ListItem', position: 2, name: title, item: canonical.href },
  ],
}] : [];
const graph = [org, ...breadcrumb, ...schema];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="naver-site-verification" content="d0586033fd852b5a82dfb099fa52528c9d74a792" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="시즐론 Sizlon" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="시즐론 — 검색 시스템, RAG, 데이터 추출. 실제로 운영해 본 사람이 합니다." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical.href} />
    {pair && !noindex && <link rel="alternate" hreflang="ko" href={pair.ko} />}
    {pair && !noindex && <link rel="alternate" hreflang="en" href={pair.en} />}
    {pair && !noindex && <link rel="alternate" hreflang="x-default" href={pair.ko} />}
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body>
    <a class="skip" href="#main">{tr.common.skip}</a>
    <Nav lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // 쿠키 없는 자체 방문 비콘 — 페이지 이탈 시점에 경로·언어·리퍼러·최대
      // 스크롤 깊이·체류시간만 svc.sizlon.io(/api/hit)로 보낸다. 식별자와
      // 쿠키는 없고, 서버도 IP를 저장하지 않는다(일일 salt 해시만). DNT 존중.
      // text/plain 문자열로 보내 CORS preflight 없는 단순 요청을 유지한다.
      const local = ['localhost', '127.0.0.1'].includes(location.hostname) || location.hostname.endsWith('.localhost');
      const dnt = navigator.doNotTrack === '1';
      let t0 = Date.now();
      let maxScroll = 0;
      let sent = false;
      const measure = () => {
        const total = document.documentElement.scrollHeight - innerHeight;
        const pct = total > 0 ? Math.round((scrollY / total) * 100) : 100;
        if (pct > maxScroll) maxScroll = Math.min(pct, 100);
      };
      const send = () => {
        if (sent || local || dnt) return;
        sent = true;
        navigator.sendBeacon(
          'https://svc.sizlon.io/api/hit',
          JSON.stringify({
            p: location.pathname,
            l: document.documentElement.lang,
            r: document.referrer,
            s: maxScroll,
            d: Date.now() - t0,
          }),
        );
      };
      addEventListener('scroll', measure, { passive: true });
      measure();
      addEventListener('pagehide', send);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') send();
      });
      // bfcache 복원(뒤로가기)은 새 방문으로 다시 계측한다.
      addEventListener('pageshow', (e) => {
        if (e.persisted) { sent = false; t0 = Date.now(); maxScroll = 0; measure(); }
      });
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-recovered);
        color: var(--color-ink);
        padding: 0.6rem 1rem;
        z-index: 20;
        border-radius: 0 0 var(--radius) 0;
      }
      .skip:focus { left: 0; }
    </style>
  </body>
</html>
